# Copy this file to .env and fill in your own values. Never commit .env.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Any PostgreSQL URL works (Supabase or local PostgreSQL).
# Supabase: open your project, click Connect, copy the Session pooler string.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/secondchance
